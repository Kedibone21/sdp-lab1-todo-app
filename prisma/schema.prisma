generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
 
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  dueDate     DateTime
  topic       String
  status      String   @default("Todo")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
}