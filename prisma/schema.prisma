generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Status {
  Todo
  InProgress
  Complete
}


model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  dueDate     DateTime
  topic       String
  status Status @default(Todo)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
}